# ─── AI Provider ───────────────────────────────────────────────────────────────
# Google Gemini API Key for generating AI Trade Plans
# Get a free key at: https://aistudio.google.com/apikey
# If missing, the app uses a built-in mock trade plan instead.
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Data Quality ─────────────────────────────────────────────────────────────
# Maximum age in minutes before fetched data is considered stale (default: 15)
DATA_STALENESS_THRESHOLD_MINUTES=15

# ─── MCX Conversion ──────────────────────────────────────────────────────────
# Import duty + GST + local premium factor applied to COMEX→MCX conversion
# Default: 1.0622 (~6.2%). Adjust if duty structure changes.
# MCX_PREMIUM_FACTOR=1.0622

# ─── Circuit Breaker Thresholds ───────────────────────────────────────────────
# Number of consecutive losses to trigger Level 1 warning (default: 3)
CIRCUIT_LEVEL1_CONSECUTIVE_LOSSES=3
# Number of consecutive losses to trigger Level 2 circuit open (default: 5)
CIRCUIT_LEVEL2_CONSECUTIVE_LOSSES=5
# Cumulative drawdown % to trigger Level 1 (default: 1.5)
CIRCUIT_LEVEL1_DRAWDOWN_PCT=1.5
# Cumulative drawdown % to trigger Level 2 (default: 3.0)
CIRCUIT_LEVEL2_DRAWDOWN_PCT=3.0

# ─── Forecast Store ──────────────────────────────────────────────────────────
# Path to the local forecast history file (default: ./forecast_store.json)
# FORECAST_STORE_PATH=./forecast_store.json
